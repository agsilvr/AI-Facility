{
  "name": "ai-facility",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && node --disable-warning=ExperimentalWarning build/server/main.js",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "vite build --ssr server/main.ts --outDir build/server",
    "start": "node --disable-warning=ExperimentalWarning build/server/main.js",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.13"
  }
}
