{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Cookies/**)",
      "Read(~/Library/Safari/**)",
      "Read(~/Library/Messages/**)",
      "Read(~/Library/Mail/**)",
      "Read(~/Library/Application Support/Google/**)",
      "Read(~/Library/Application Support/Firefox/**)",
      "Read(~/Library/Application Support/BraveSoftware/**)",
      "Read(~/Library/Application Support/Microsoft Edge/**)",
      "Read(~/Library/Application Support/com.apple.TCC/**)",
      "Read(//Users/Shared/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./data/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./data/**)",
      "Edit(./.claude/settings.json)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.ssh/**)",
      "Edit(~/.claude/**)",
      "Edit(//etc/**)",
      "Edit(//Library/**)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(security:*)",
      "Bash(osascript:*)",
      "Bash(defaults write:*)",
      "Bash(dscl:*)",
      "Bash(csrutil:*)",
      "Bash(spctl:*)",
      "Bash(xattr:*)",
      "Bash(tccutil:*)",
      "Bash(networksetup:*)",
      "Bash(systemsetup:*)",
      "Bash(crontab:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(nc:*)",
      "Bash(npm publish:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git config --global:*)",
      "Bash(gh auth:*)",
      "Bash(claude setup-token:*)"
    ],
    "ask": [
      "Bash(launchctl:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(open:*)",
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npx:*)",
      "WebFetch",
      "Edit(~/Library/LaunchAgents/**)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": true,
    "filesystem": {
      "allowWrite": ["~/.npm", "~/Library/LaunchAgents/com.aifacility.server.plist"],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/Library/Keychains",
        "~/Library/Cookies",
        "~/Library/Safari",
        "~/Library/Messages",
        "~/Library/Mail",
        "~/Library/Application Support/Google",
        "~/Library/Application Support/Firefox",
        "~/Library/Application Support/BraveSoftware",
        "~/Library/Application Support/Microsoft Edge"
      ],
      "denyWrite": ["./.claude/settings.json", "./data"]
    },
    "network": {
      "allowedDomains": ["github.com", "codeload.github.com", "objects.githubusercontent.com", "registry.npmjs.org"]
    }
  }
}
